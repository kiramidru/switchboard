{
  "name": "switchboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --config vite.extension.config.ts && uv run python ../scripts/package_extension.py",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -b",
    "test:adapter": "playwright test --config=playwright.adapter.config.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.0",
    "@fontsource/source-serif-4": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
